# ==============================================================================
# THINKUP BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# CẤU HÌNH SERVER & ANGULAR CLIENT
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200
ADMIN_URL=http://localhost:4201
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# JWT & AUTH
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# MONGODB DATABASE
MONGODB_URI=mongodb://127.0.0.1:27017/thinkup_db
MONGODB_DB_NAME=thinkup_db

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FACEBOOK OAUTH
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# EMAIL (SMTP GMAIL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ThinkUp" <noreply@thinkup.vn>
