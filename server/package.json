{
  "name": "thinkup-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test src/user/test/*.test.js",
    "test:routes": "node --test src/user/test/server.routes.test.js",
    "test:signup": "node --test src/user/test/signup.user.test.js",
    "test:signin": "node --test src/user/test/signin.user.test.js",
    "test:forgot": "node --test src/user/test/forgot-password.user.test.js",
    "test:onboarding": "node --test src/user/test/onboarding.user.test.js",
    "recheck": "node recheck/recheck-auth.js",
    "recheck:signup": "node recheck/test-signup.js",
    "recheck:signin": "node recheck/test-signin.js",
    "recheck:forgot": "node recheck/test-forgot.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "nodemailer": "^7.0.13"
  }
}