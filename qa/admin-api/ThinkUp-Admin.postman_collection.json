    {
      "name": "FAQ • tạo, sửa, sắp xếp, ẩn, tải lại, xóa",
      "item": [
        {
          "name": "FA bị từ chối",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/support/faqs",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenFA}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chặn câu hỏi trống",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/support/faqs",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryCode\": \"other\",\n  \"question\": \"\",\n  \"answer\": \"QA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo câu hỏi thử",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/support/faqs",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryCode\": \"other\",\n  \"question\": \"QA {{$guid}}\",\n  \"answer\": \"Kiểm thử API\",\n  \"status\": \"published\",\n  \"orderIndex\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"faqId\", pm.response.json().data.item._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sửa nội dung",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/admin/support/faqs/{{faqId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answer\": \"QA updated\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Đổi thứ tự",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/support/faqs/{{faqId}}/reorder",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderIndex\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ẩn câu hỏi",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/support/faqs/{{faqId}}/toggle-status",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Kiểm tra sau tải lại",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/support/faqs?q=QA&limit=100",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cùng bản ghi đã sửa và ẩn\", () => { const row = pm.response.json().data.items.find(x => x.id === pm.collectionVariables.get(\"faqId\")); pm.expect(row.answer).to.eql(\"QA updated\"); pm.expect(row.status).to.eql(\"hidden\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Xóa bản ghi vừa tạo",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/support/faqs/{{faqId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Kiểm tra đã xóa",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/support/faqs?q=QA&limit=100",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCS}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Đã xóa\", () => pm.expect(pm.response.json().data.items.some(x => x.id === pm.collectionVariables.get(\"faqId\"))).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
